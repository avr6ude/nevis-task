{
  "name": "nevis-task",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "css:types": "hcm 'src/**/*.module.css' --localsConvention camelCaseOnly --no-declarationMap --arbitraryExtensions",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:dev:api\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run css:types && tsc -b && vite build",
    "lint": "biome check",
    "test": "npm run css:types && vitest run",
    "test:watch": "vitest",
    "format": "biome format --write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@visx/axis": "^4.0.0",
    "@visx/grid": "^4.0.0",
    "@visx/group": "^4.0.0",
    "@visx/scale": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@visx/tooltip": "^4.0.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swr": "^2.5.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "happy-css-modules": "^5.0.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
